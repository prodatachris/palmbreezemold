# Cache + security headers.
#
# Read natively by Netlify and Cloudflare Pages. EVERYWHERE ELSE THIS FILE DOES
# NOTHING — it is inert on Google Cloud Storage, Firebase, S3, Nginx and cPanel,
# and it fails silently, which is the dangerous part: the site looks like it has
# a caching policy while every asset is served on the host's default TTL.
#
# If you are not on Netlify or Pages, see the Deploying section of README.md.
# For a GCS bucket, ./deploy/gcs-cache-headers.sh applies the caching rules
# below; the security headers need Firebase Hosting or a Load Balancer policy.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css and site.js are NOT content-hashed, so they get a short TTL.
# If you add a hashing step to build.mjs, raise these to immutable too.
/styles.css
  Cache-Control: public, max-age=3600

/site.js
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
